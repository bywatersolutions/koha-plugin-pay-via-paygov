[% INCLUDE 'doc-head-open.inc' %]
 <title>Koha: Plugin: Pay Via PayGov: Configuration</title>
[% INCLUDE 'doc-head-close.inc' %]
</head>
<body>
[% INCLUDE 'header.inc' %]
[% INCLUDE 'cat-search.inc' %]

<div id="breadcrumbs"><a href="/cgi-bin/koha/mainpage.pl">Home</a> &rsaquo; <a href="/cgi-bin/koha/plugins/plugins-home.pl">Plugins</a> &rsaquo; Pay Via PayGov &rsaquo; Configuration</div>

<div id="doc3">
    <!-- We can access our own plugins resource files using the PLUGIN_PATH variable. -->
    <h3>Koha: Plugin: Pay Via PayGov: Configuration</h3>

	[% UNLESS encryption_available %]
	  <div class="dialog alert">
		<strong>Koha's encryption is not available.</strong>
		The API password can only be stored in cleartext until an <code>encryption_key</code> is set in
		<code>koha-conf.xml</code>. Add one (we recommend at least 32 bytes, for example
		<code>pwgen 32 1</code>), restart Koha, then reopen this page and the stored password will be
		encrypted automatically.
	  </div>
	[% ELSIF PayGovApiPassword_is_set AND NOT PayGovApiPassword_is_encrypted %]
	  <div class="dialog alert">
		<strong>The stored API password is not encrypted.</strong>
		Re-enter it below and save to store it encrypted.
	  </div>
	[% END %]

	<form method='post'>
	  <input type="hidden" name="class" value="[% CLASS %]"/>
	  <input type="hidden" name="method" value="[% METHOD %]"/>
	  <input type="hidden" name="save" value="1" />
	  [% IF csrf_token %]<input type="hidden" name="csrf_token" value="[% csrf_token | html %]" />[% END %]

	  <div class="form-group">
			<label for="enable_opac_payments">Enable OPAC Account Payments: </label>
			<select class="form-control" name="enable_opac_payments">
				[% IF enable_opac_payments == 'No' %]
					<option value="No" selected="selected">No</option>
				[% ELSE %]
					<option value="No">No</option>
				[% END %]

				[% IF enable_opac_payments == 'Yes' %]
					<option value="Yes" selected="selected">Yes</option>
				[% ELSE %]
					<option value="Yes">Yes</option>
				[% END %]
			</select>
	  </div>

	  <div class="form-group">
		<label for="PayGovPostUrl">PayGov Post URL</label>
		<input type="text" class="form-control" id="PayGovPostUrl" name="PayGovPostUrl" value="[% PayGovPostUrl | html %]" />
	  </div>

	  <div class="form-group">
		<label for="PayGovMerchantCode">PayGov TTID: </label>
		<input type="text" class="form-control" id="PayGovMerchantCode" name="PayGovMerchantCode" value="[% PayGovMerchantCode | html %]" />
	  </div>

	  <div class="form-group">
		<label for="PayGovSettleCode">PayGov Settle Code: </label>
		<input type="text" class="form-control" id="PayGovSettleCode" name="PayGovSettleCode" value="[% PayGovSettleCode | html %]" />
	  </div>

	  <div class="form-group">
		<label for="PayGovApiUrl">PayGov API URL: </label>
		<input type="text" class="form-control" id="PayGovApiUrl" name="PayGovApiUrl" value="[% PayGovApiUrl | html %]" />
	  </div>

	  <div class="form-group">
		<label for="PayGovApiPassword">PayGov API Password: </label>
		<input type="password" class="form-control" id="PayGovApiPassword" name="PayGovApiPassword" value="" autocomplete="new-password" />
		<p class="help-block">
		  [% IF PayGovApiPassword_is_set %]
			A password is already stored. Leave this blank to keep it, or enter a new one to replace it.
		  [% ELSE %]
			No password is stored yet.
		  [% END %]
		</p>
	  </div>

	  <button type="submit" class="btn btn-default">Save</button>
	</form>

[% INCLUDE 'intranet-bottom.inc' %]
